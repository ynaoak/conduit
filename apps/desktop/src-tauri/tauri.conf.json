{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conduit",
  "version": "0.2.0",
  "identifier": "com.conduit.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../../build/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Conduit",
        "width": 782,
        "height": 507,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3MzZFRTY5MTM3MDA3RgpSV1IvQURlUjVtNXpCVGNER0RjMVpPV0hEazZ5bi9qWG9WRmwrVFE2Y1RZd0JabEhXb2piQkI0ego=",
      "endpoints": [
        "https://github.com/ynaoak/conduit/releases/latest/download/latest.json"
      ]
    }
  }
}
