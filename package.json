{
  "name": "conduit",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "tsc -p apps/desktop/tsconfig.json && vite build --config apps/desktop/vite.config.ts",
    "check:colors": "node scripts/check-color-system.mjs",
    "preview": "vite preview --config apps/desktop/vite.config.ts",
    "tauri": "cd apps/desktop && tauri",
